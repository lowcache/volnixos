layout {

    focus-ring {
        active-color   "#e8a87c"
        inactive-color "#1e1a24"
        urgent-color   "#d96b6b"
    }

    border {
        active-color   "#e8a87c"
        inactive-color "#1e1a24"
        urgent-color   "#d96b6b"
    }


    tab-indicator {
        active-color   "#e8a87c"
        inactive-color "#9b4c17"
        urgent-color   "#d96b6b"
    }

    insert-hint {
        color "#e8a87c80"
    }
}

recent-windows {
    highlight {
        active-color "#e8a87c"
        urgent-color "#d96b6b"
    }
}
