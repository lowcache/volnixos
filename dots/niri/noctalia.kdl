layout {

    focus-ring {
        active-color   "#81a2be"
        inactive-color "#1d1f21"
        urgent-color   "#cc6666"
    }

    border {
        active-color   "#81a2be"
        inactive-color "#1d1f21"
        urgent-color   "#cc6666"
    }


    tab-indicator {
        active-color   "#81a2be"
        inactive-color "#294964"
        urgent-color   "#cc6666"
    }

    insert-hint {
        color "#81a2be80"
    }
}

recent-windows {
    highlight {
        active-color "#81a2be"
        urgent-color "#cc6666"
    }
}
