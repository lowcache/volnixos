// Vol NixOS — Niri compositor config (niri 26.04, KDL). Persisted live via out-of-store symlink (~/.nix-config/home/persist.nix).
// Validate: niri validate -c ~/.config/niri/config.kdl   (hot-reloads on save)
// Attempted Keybind port from dots/hypr/hyprland/keybinds.conf was successful, a more focused attempt in the future might be beneficial to a more comprehensive config.
// Noctalia v5 is the shell/bar (spawn-at-startup below); shell actions use `noctalia msg`.
// **C** = ATTN CLAUDE QUAKE ENGINE 
input {
    keyboard {
        xkb {
            layout "us"
        }
    }
    touchpad {
        tap
        natural-scroll
        disabled-on-external-mouse
        off // @tptoggle@   -- toggled by F10 / touchpad_toggle.sh (uncommented = disabled)
    }
    mouse {
      // off
    }
    focus-follows-mouse max-scroll-amount="0%"
}

// Outputs: niri auto-detects. Pin explicitly after `niri msg outputs` if needed.
// output "eDP-1" { mode "1920x1080@60.000"; scale 1.0 }

layout {
    gaps 5
    // "on-overflow": the focused column stays put until the row would overflow,
    // then it centers — far less disorienting than columns sliding off both edges.
    // Options: "never" | "always" | "on-overflow". Tune to taste.
    center-focused-column "on-overflow"
    always-center-single-column
    empty-workspace-above-first
    default-column-display "normal" 
    // default-column-display "tabbed"
    preset-column-widths {
        proportion 0.33333 // 3 equal columns or 2 unequal columns
        proportion 0.5 // 2 equal columns
        proportion 0.66667 // 2 unequal columns
        proportion 1.0  // 1 column (whole screen)
    }
    default-column-width { proportion 1.0; } // whole screen as default; cycle with Mod+minus / Mod+equal, or set per-app via window-rule
    preset-window-heights { 
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    // Neon focus-ring (toxic/radioactive_slime primary). TODO: drive from color-engine.
    focus-ring {
        on
        width 1
        active-color "#B4FF00"
        // active-gradient from="" to="" angle=
        inactive-color "#2e2e2e"
    }
    border {
        off
        // active-color/gradient
        // inactive-color/gradient
        // urgent-color/gradient
    }
    shadow {
      off
      // softness 30
      // spread 5
      // offset x=0 y=0
      // draw-behind-window true
      // color/inactive-color
    }
    tab-indicator {
      off
      // hide-when-single-tab
      // place-within-column
      // gap 5
      // width 4
      // length total-proportion=1.0
      // position "right"
      // gaps-between-tabs 2
      // corner-radius 8
      // active-color/gradient
      // inactive-color/gradient
      // urgent-color/gradient
    }
    insert-hint {
      off
      // color/gradient
    }
    struts {
      // left/right/top/bottom
    }
}

// --- Startup: Noctalia v5 shell (bar, control center, panels) ---
spawn-at-startup "noctalia"

prefer-no-csd
screenshot-path "~/Storage/screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

// `empty-workspace-above-first` (layout block) always keeps an empty workspace at
// idx 1, and the declared named workspace below is pinned to the lowest *real* index
// (idx 2). The Mod+1..9 binds therefore target indices 2..10 (see below).
// Verify with: niri msg -j workspaces
workspace "mopho"
// Quake terminal: floating kitty (app-id "quake"), toggled by the niri-port script.
// **C**This functionality is performed by kitty's kitten+quick-access-terminal syntax seen below
// window-rule {
//     match app-id="^quake$"
//     open-floating true
//     default-column-width { proportion 0.98; }
// }

binds {
    // ===== Shell / Noctalia (replaces quickshell IPC) =====
    // Panel ids come from `noctalia msg panel-toggle <bad-id>`, which prints the list.
    Mod+Space        { spawn-sh "noctalia msg panel-toggle launcher"; }      // Launcher (was Super-tap)
    Mod+Tab          { toggle-overview; }                                    // Overview
    Mod+A            { spawn-sh "noctalia msg panel-toggle control-center"; } // Control center
    Mod+J            { spawn-sh "noctalia msg bar-toggle"; }                 // Toggle bar
    Mod+M            { spawn-sh "noctalia msg panel-toggle control-center media"; } // Media controls
    Mod+Period       { spawn-sh "noctalia msg panel-toggle launcher /emo"; } // Emoji picker
    Mod+Slash        { show-hotkey-overlay; }                                // Cheatsheet (niri's own overlay)
    Mod+V            { spawn-sh "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; } // Clipboard history
    Alt+Tab          { spawn-sh "noctalia msg window-switcher"; }            // Window switcher overlay
    Ctrl+Alt+Delete  { spawn-sh "wlogout -p layer-shell"; }                  // Session menu
    F10              { spawn-sh "~/.config/niri/scripts/touchpad_toggle.sh"; }      // Touchpad on/off (ASUS Fn)
    XF86TouchpadToggle { spawn-sh "~/.config/niri/scripts/touchpad_toggle.sh"; }    // Touchpad on/off

    // ===== Shell toggles =====
    Mod+N            { spawn-sh "noctalia msg notification-dnd-toggle"; }    // Do Not Disturb
    Mod+Shift+A      { spawn-sh "noctalia msg caffeine-toggle"; }            // Idle inhibitor
    Mod+Shift+W      { spawn-sh "noctalia msg wallpaper-random"; }           // Random wallpaper
    Mod+Ctrl+N       { spawn-sh "noctalia msg nightlight-force-toggle"; }    // Night light
    Mod+Ctrl+B       { spawn-sh "noctalia msg theme-mode-toggle"; }          // Dark / light

    // ===== Apps =====
    // **C** Quake terminal: niri only spawns a process; ALL window logic (show/hide,
    // position, height, aspect) is done by kitty's quick-access-terminal kitten over
    // wlr-layer-shell + kitty remote control, bypassing the compositor entirely.
    // Config: ~/.config/kitty/quick-access-terminal.conf  Helper: scripts/quake.sh
    // (app-id "quake" is set in the kitten conf, for debugging/matching only.)
    // All controls are two-state, orientation-aware toggles hung off Mod+Return:
    Mod+Return       { spawn-sh "~/.config/niri/scripts/quake.sh toggle"; }      // show / hide
    Mod+Shift+Return { spawn-sh "~/.config/niri/scripts/quake.sh position"; }    // top/bottom (landscape) · left/right (portrait)
    Mod+Alt+Return   { spawn-sh "~/.config/niri/scripts/quake.sh size"; }        // normal / full extent
    Mod+Ctrl+Return  { spawn-sh "~/.config/niri/scripts/quake.sh orientation"; } // landscape (horizontal) / portrait (vertical)
    Mod+T            { spawn "kitty"; }                                       // Terminal
    Mod+E           { spawn-sh "~/.config/niri/scripts/launch_first_available.sh dolphin nautilus nemo thunar 'kitty -1 fish -c yazi'"; } // Files
    Mod+W            { spawn-sh "~/.config/niri/scripts/launch_first_available.sh brave google-chrome-stable zen-browser firefox chromium"; } // Browser
    Mod+C            { spawn-sh "~/.config/niri/scripts/launch_first_available.sh antigravity code vscodium cursor zed kate gnome-text-editor emacs"; } // Code editor
    Mod+X            { spawn-sh "~/.config/niri/scripts/launch_first_available.sh kate gedit emacs"; } // Text editor
    Mod+I            { spawn-sh "noctalia msg settings-open"; } // Noctalia settings
    Mod+Ctrl+V       { spawn-sh "~/.config/niri/scripts/launch_first_available.sh pavucontrol-qt pavucontrol"; } // Volume mixer
    Ctrl+Shift+Escape { spawn-sh "~/.config/niri/scripts/launch_first_available.sh gnome-system-monitor 'kitty -1 fish -c btop'"; } // Task manager

    // ========================================================================
    // NAVIGATION MODEL — read this before editing anything below.
    //
    // niri has THREE independent axes:
    //
    //   COLUMN axis     columns scroll horizontally across a workspace   -> Left / Right
    //   WORKSPACE axis  workspaces stack vertically on a monitor         -> Up / Down
    //   WINDOW axis     windows stack vertically INSIDE one column       -> Up / Down
    //
    // The two vertical axes share the arrow keys, so they are separated by modifier.
    // NOTHING is bound to Page_Up / Page_Down: on this ASUS chassis those are Fn-layer
    // keys, and hitting the Fn sequence in the wrong order can toggle the Super-key
    // lock, which silently kills every Mod+ bind in this file. Keep them unbound.
    //
    // Left/Right follows a clean rule (Shift = move it, Ctrl = regroup windows).
    // Up/Down is ordered by FREQUENCY OF USE instead, because Alt sits next to Super
    // and is awkward to reach — so the common actions get the comfortable modifiers
    // and only the rare ones get pushed out to Alt. Read the table, don't infer a rule:
    //
    //   Mod+Up/Down              focus workspace                  (most used)
    //   Mod+Shift+Up/Down        focus window inside the column
    //   Mod+Ctrl+Up/Down         move COLUMN to another workspace
    //   Mod+Ctrl+Shift+Up/Down   reorder window inside the column
    //   Mod+Alt+Up/Down          move one WINDOW to another workspace (rare)
    //   Mod+Alt+Shift+Up/Down    reorder the WORKSPACE in the stack   (rarest)
    //
    // The three "move" verbs, which is what trips people up:
    //   move-column-left/right      slides the column past a *neighbouring column*.
    //                               With one column on the workspace this is a no-op —
    //                               expected, not a broken bind. To move a single
    //                               WINDOW sideways use consume-or-expel instead.
    //   move-column-to-workspace-*  the focused COLUMN travels to a neighbouring
    //                               workspace. Workspaces themselves stay put.
    //   move-workspace-*            reorders the WHOLE WORKSPACE in the monitor's
    //                               stack. Nothing inside it changes; the workspace
    //                               swaps places with its neighbour.
    // ========================================================================

    // ===== Column axis (Left / Right) =====
    Mod+Left             { focus-column-left; }
    Mod+Right            { focus-column-right; }
    Mod+Shift+Left       { move-column-left; }                    // slide column past its neighbour
    Mod+Shift+Right      { move-column-right; }
    Mod+Ctrl+Left        { consume-or-expel-window-left; }        // pull window into / push out of the column to the left
    Mod+Ctrl+Right       { consume-or-expel-window-right; }
    Mod+Alt+Left         { swap-window-left; }                    // trade places with the neighbouring window
    Mod+Alt+Right        { swap-window-right; }
    Mod+Home             { focus-column-first; }
    Mod+End              { focus-column-last; }
    Mod+Shift+Home       { move-column-to-first; }
    Mod+Shift+End        { move-column-to-last; }

    // ===== Workspace axis (Up / Down) =====
    Mod+Up               { focus-workspace-up; }
    Mod+Down             { focus-workspace-down; }
    Mod+Ctrl+Up          { move-column-to-workspace-up; }         // column travels to the workspace above
    Mod+Ctrl+Down        { move-column-to-workspace-down; }
    Mod+Alt+Shift+Up     { move-workspace-up; }                   // reorder the workspace itself in the stack
    Mod+Alt+Shift+Down   { move-workspace-down; }
    Mod+Grave            { focus-workspace-previous; }            // toggle back to last workspace
    Mod+WheelScrollUp    { focus-workspace-up; }
    Mod+WheelScrollDown  { focus-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }

    // ===== Window axis (Up / Down) — within the focused column =====
    Mod+Shift+Up         { focus-window-up; }                     // move focus between stacked windows
    Mod+Shift+Down       { focus-window-down; }
    Mod+Ctrl+Shift+Up    { move-window-up; }                      // reorder window inside its column
    Mod+Ctrl+Shift+Down  { move-window-down; }
    Mod+Alt+Up           { move-window-to-workspace-up; }         // move ONLY this window, leave the column behind
    Mod+Alt+Down         { move-window-to-workspace-down; }
    Mod+Shift+Tab        { focus-window-previous; }

    // ===== Monitors — DISABLED (single-output machine) =====
    // Dormant since the 3-monitor setup went away; every one of these is a no-op with
    // one output. Uncomment if a second display ever comes back — but note that
    // Mod+Alt+Left/Right is now taken by swap-window-* in the Column axis section, so
    // that pair needs a new home (Mod+Alt+Shift+Left/Right below is still free).
    //   Mod+Alt+Left         { move-column-to-monitor-left; }
    //   Mod+Alt+Right        { move-column-to-monitor-right; }
    //   Mod+Alt+Shift+Left   { focus-monitor-left; }
    //   Mod+Alt+Shift+Right  { focus-monitor-right; }
    //   Mod+Alt+Grave        { focus-monitor-next; }   // cycles outputs whatever the geometry
    // Also available if needed: move-window-to-monitor-*, move-workspace-to-monitor-*,
    // focus-monitor-previous/next, and the -up/-down variants of all of the above.

    // ===== Numbered workspaces =====
    // Indices are offset by +1: `empty-workspace-above-first` occupies idx 1, so the
    // first real workspace ("mopho") is idx 2 and Mod+9 lands on idx 10.
    Mod+1            { focus-workspace 2; }
    Mod+2            { focus-workspace 3; }
    Mod+3            { focus-workspace 4; }
    Mod+4            { focus-workspace 5; }
    Mod+5            { focus-workspace 6; }
    Mod+6            { focus-workspace 7; }
    Mod+7            { focus-workspace 8; }
    Mod+8            { focus-workspace 9; }
    Mod+9            { focus-workspace 10; }
    // Mod+Alt+<n> = send the focused column to workspace <n>.
    Mod+Alt+1        { move-column-to-workspace 2; }
    Mod+Alt+2        { move-column-to-workspace 3; }
    Mod+Alt+3        { move-column-to-workspace 4; }
    Mod+Alt+4        { move-column-to-workspace 5; }
    Mod+Alt+5        { move-column-to-workspace 6; }
    Mod+Alt+6        { move-column-to-workspace 7; }
    Mod+Alt+7        { move-column-to-workspace 8; }
    Mod+Alt+8        { move-column-to-workspace 9; }
    Mod+Alt+9        { move-column-to-workspace 10; }

    // ===== Window state =====
    Mod+Q            { close-window; }
    Mod+D            { maximize-column; }              // "Maximize" (column fills the screen)
    Mod+F            { fullscreen-window; }
    Mod+Shift+F      { maximize-window-to-edges; }
    Mod+Ctrl+F       { expand-column-to-available-width; }
    Mod+Ctrl+C       { center-column; }
    Mod+Ctrl+T       { toggle-column-tabbed-display; } // stack the column's windows as tabs
    Mod+Alt+Space    { toggle-window-floating; }       // send window to / from the floating layer
    Mod+Ctrl+Space   { switch-focus-between-floating-and-tiling; }
    Mod+Shift+V      { spawn-sh "$HOME/.local/bin/mopho-view"; }

    // ===== Sizing =====
    Mod+minus        { switch-preset-column-width-back; }   // cycle preset-column-widths
    Mod+equal        { switch-preset-column-width; }
    Mod+Shift+minus  { switch-preset-window-height-back; }  // cycle preset-window-heights
    Mod+Shift+equal  { switch-preset-window-height; }
    Mod+Ctrl+minus   { set-column-width "-10%"; }           // fine adjustment
    Mod+Ctrl+equal   { set-column-width "+10%"; }
    Mod+Ctrl+0       { reset-window-height; }


    // ===== Media / Volume / Brightness (function keys) =====
    XF86AudioRaiseVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%+ -l 1.5"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 2%-"; }
    XF86AudioMute         allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    XF86AudioMicMute      allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg brightness-down"; }
    XF86AudioNext         allow-when-locked=true { spawn-sh "noctalia msg media next"; }
    XF86AudioPrev         allow-when-locked=true { spawn-sh "noctalia msg media previous"; }
    XF86AudioPlay         allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86AudioPause        allow-when-locked=true { spawn-sh "noctalia msg media toggle"; }
    XF86KbdBrightnessUp   allow-when-locked=true { spawn-sh "noctalia msg keyboard-backlight-up"; }
    XF86KbdBrightnessDown allow-when-locked=true { spawn-sh "noctalia msg keyboard-backlight-down"; }

    // ===== Screenshots / capture =====
    Print            { screenshot-screen; }           // Focused screen
    Shift+Print      { screenshot; }                  // Region (interactive)
    Alt+Print        { screenshot-window; }           // Focused window
    Mod+Shift+S      { screenshot; }                  // Region (interactive)
    Mod+Shift+C      { spawn-sh "hyprpicker -a"; }    // Color picker
    Mod+Shift+X      { spawn-sh "grim -g \"$(slurp)\" /tmp/ocr.png && tesseract /tmp/ocr.png stdout | wl-copy && rm /tmp/ocr.png"; } // OCR

    // ===== Session =====
    Mod+L            { spawn-sh "loginctl lock-session"; }       // Lock
    Mod+Shift+L      { spawn-sh "systemctl suspend"; }           // Suspend
    Mod+Shift+Delete { spawn-sh "systemctl poweroff"; }          // Power off

    // ===== niri / shell control =====
    Mod+Ctrl+R       { spawn-sh "noctalia msg config-reload"; }  // Reload Noctalia config
    Mod+Ctrl+Shift+R { spawn-sh "niri msg action load-config-file"; } // Reload niri config (it also auto-reloads on save)
    Mod+Ctrl+Shift+E { quit; }                                   // Exit niri (moved off Mod+Shift+E)
    Mod+Shift+O      { power-off-monitors; }                     // DPMS off
    Mod+Ctrl+Escape  { toggle-keyboard-shortcuts-inhibit; }      // Let a VM / remote desktop eat all keys

    // ===== Deliberate aliases =====
    // Same action as a bind above, kept for muscle memory or hardware that lacks the
    // primary key. Safe to delete any line here without losing functionality.
    Alt+F4           { close-window; }                       // == Mod+Q
    Ctrl+Alt+T       { spawn "kitty"; }                      // == Mod+T
    Mod+KP_Subtract  { switch-preset-column-width-back; }    // == Mod+minus
    Mod+KP_Add       { switch-preset-column-width; }         // == Mod+equal
    Mod+Shift+P      { spawn-sh "noctalia msg media toggle"; }   // == XF86AudioPlay
    Mod+Shift+N      { spawn-sh "noctalia msg media next"; }     // == XF86AudioNext
    Mod+Shift+B      { spawn-sh "noctalia msg media previous"; } // == XF86AudioPrev
    Mod+Shift+M      { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; } // == XF86AudioMute
}

include "noctalia.kdl"
